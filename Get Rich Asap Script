				return object
			end

			function TabObject:CreateToggle(data)
				local row = Instance.new("TextButton")
				row.Size = UDim2.new(1, -6, 0, 42)
				row.BackgroundColor3 = Color3.fromRGB(27, 32, 44)
				row.BorderSizePixel = 0
				row.Text = ""
				row.AutoButtonColor = false
				row.Parent = page
				round(row, 8)

				local nameLabel = makeText(
					row,
					tostring(data and data.Name or "Toggle"),
					12,
					Enum.Font.GothamBold,
					Color3.fromRGB(225, 231, 244)
				)
				nameLabel.Size = UDim2.new(1, -75, 1, 0)
				nameLabel.Position = UDim2.fromOffset(10, 0)

				local pill = Instance.new("Frame")
				pill.Size = UDim2.fromOffset(44, 23)
				pill.Position = UDim2.new(1, -56, 0.5, -11)
				pill.BorderSizePixel = 0
				pill.Parent = row
				round(pill, 12)

				local dot = Instance.new("Frame")
				dot.Size = UDim2.fromOffset(17, 17)
				dot.BorderSizePixel = 0
				dot.Parent = pill
				round(dot, 9)

				local object = {
					CurrentValue = data and data.CurrentValue == true or false
				}

				local function render()
					if object.CurrentValue then
						pill.BackgroundColor3 = Color3.fromRGB(54, 142, 93)
						dot.BackgroundColor3 = Color3.fromRGB(230, 255, 239)
						dot.Position = UDim2.fromOffset(24, 3)
					else
						pill.BackgroundColor3 = Color3.fromRGB(65, 69, 81)
						dot.BackgroundColor3 = Color3.fromRGB(215, 219, 226)
						dot.Position = UDim2.fromOffset(3, 3)
					end
				end

				function object:Set(value)
					object.CurrentValue = value == true
					render()

					if data and data.Flag then
						Fallback.Flags[data.Flag] = object
					end

					if data and type(data.Callback) == "function" then
						data.Callback(object.CurrentValue)
					end
				end

				row.MouseButton1Click:Connect(function()
					object:Set(not object.CurrentValue)
				end)

				render()

				if data and data.Flag then
					Fallback.Flags[data.Flag] = object
				end

				return object
			end

			function TabObject:CreateSlider(data)
				local row = Instance.new("Frame")
				row.Size = UDim2.new(1, -6, 0, 66)
				row.BackgroundColor3 = Color3.fromRGB(27, 32, 44)
				row.BorderSizePixel = 0
				row.Parent = page
				round(row, 8)

				local nameLabel = makeText(
					row,
					tostring(data and data.Name or "Slider"),
					12,
					Enum.Font.GothamBold,
					Color3.fromRGB(225, 231, 244)
				)
				nameLabel.Size = UDim2.new(1, -120, 0, 26)
				nameLabel.Position = UDim2.fromOffset(10, 4)

				local valueLabel = makeText(
					row,
					"",
					11,
					Enum.Font.GothamBold,
					Color3.fromRGB(115, 170, 245)
				)
				valueLabel.Size = UDim2.fromOffset(105, 26)
				valueLabel.Position = UDim2.new(1, -115, 0, 4)
				valueLabel.TextXAlignment = Enum.TextXAlignment.Right

				local bar = Instance.new("Frame")
				bar.Size = UDim2.new(1, -20, 0, 8)
				bar.Position = UDim2.fromOffset(10, 43)
				bar.BackgroundColor3 = Color3.fromRGB(52, 58, 72)
				bar.BorderSizePixel = 0
				bar.Parent = row
				round(bar, 4)

				local fill = Instance.new("Frame")
				fill.Size = UDim2.new(0, 0, 1, 0)
				fill.BackgroundColor3 = Color3.fromRGB(72, 130, 220)
				fill.BorderSizePixel = 0
				fill.Parent = bar
				round(fill, 4)

				local range = data and data.Range or {0, 100}
				local minimum = tonumber(range[1]) or 0
				local maximum = tonumber(range[2]) or 100
				local increment = tonumber(data and data.Increment) or 1

				local object = {
					CurrentValue = tonumber(data and data.CurrentValue) or minimum
				}

				local function render(callCallback)
					object.CurrentValue = math.clamp(
						object.CurrentValue,
						minimum,
						maximum
					)

					local alpha = 0
					if maximum > minimum then
						alpha = (object.CurrentValue - minimum) / (maximum - minimum)
					end

					fill.Size = UDim2.new(alpha, 0, 1, 0)
					valueLabel.Text =
						tostring(object.CurrentValue)
						..
						tostring(data and data.Suffix or "")

					if callCallback and data and type(data.Callback) == "function" then
						data.Callback(object.CurrentValue)
					end
				end

				function object:Set(value)
					local number = tonumber(value)
					if not number then
						return
					end

					number =
						math.floor(number / increment + 0.5)
						*
						increment

					object.CurrentValue = number
					render(true)
				end

				local draggingSlider = false

				local function updateFromX(x)
					local alpha = math.clamp(
						(x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1),
						0,
						1
					)

					local value =
						minimum
						+
						(maximum - minimum) * alpha

					object:Set(value)
				end

				bar.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 then
						draggingSlider = true
						updateFromX(input.Position.X)
					end
				end)

				game:GetService("UserInputService").InputChanged:Connect(function(input)
					if draggingSlider and input.UserInputType == Enum.UserInputType.MouseMovement then
						updateFromX(input.Position.X)
					end
				end)

				game:GetService("UserInputService").InputEnded:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 then
						draggingSlider = false
					end
				end)

				if data and data.Flag then
					Fallback.Flags[data.Flag] = object
				end

				render(false)
				return object
			end

			function TabObject:CreateInput(data)
				local row = Instance.new("Frame")
				row.Size = UDim2.new(1, -6, 0, 68)
				row.BackgroundColor3 = Color3.fromRGB(27, 32, 44)
				row.BorderSizePixel = 0
				row.Parent = page
				round(row, 8)

				local nameLabel = makeText(
					row,
					tostring(data and data.Name or "Input"),
					12,
					Enum.Font.GothamBold,
					Color3.fromRGB(225, 231, 244)
				)
				nameLabel.Size = UDim2.new(1, -20, 0, 25)
				nameLabel.Position = UDim2.fromOffset(10, 3)

				local box = Instance.new("TextBox")
				box.Size = UDim2.new(1, -20, 0, 30)
				box.Position = UDim2.fromOffset(10, 31)
				box.BackgroundColor3 = Color3.fromRGB(20, 24, 33)
				box.BorderSizePixel = 0
				box.Font = Enum.Font.Gotham
				box.Text = tostring(data and data.CurrentValue or "")
				box.PlaceholderText = tostring(data and data.PlaceholderText or "")
				box.TextSize = 12
				box.TextColor3 = Color3.fromRGB(235, 239, 248)
				box.PlaceholderColor3 = Color3.fromRGB(115, 125, 145)
				box.ClearTextOnFocus = false
				box.Parent = row
				round(box, 6)
				padding(box, 8, 8, 0, 0)

				local object = {
					CurrentValue = box.Text
				}

				function object:Set(value)
					box.Text = tostring(value)
					object.CurrentValue = box.Text

					if data and type(data.Callback) == "function" then
						data.Callback(object.CurrentValue)
					end
				end

				box.FocusLost:Connect(function()
					object.CurrentValue = box.Text

					if data and type(data.Callback) == "function" then
						data.Callback(box.Text)
					end

					if data and data.RemoveTextAfterFocusLost then
						box.Text = ""
					end
				end)

				if data and data.Flag then
					Fallback.Flags[data.Flag] = object
				end

				return object
			end

			function TabObject:CreateDropdown(data)
				local row = Instance.new("Frame")
				row.Size = UDim2.new(1, -6, 0, 68)
				row.BackgroundColor3 = Color3.fromRGB(27, 32, 44)
				row.BorderSizePixel = 0
				row.Parent = page
				round(row, 8)

				local nameLabel = makeText(
					row,
					tostring(data and data.Name or "Dropdown"),
					12,
					Enum.Font.GothamBold,
					Color3.fromRGB(225, 231, 244)
				)
				nameLabel.Size = UDim2.new(1, -20, 0, 25)
				nameLabel.Position = UDim2.fromOffset(10, 3)

				local selectButton = Instance.new("TextButton")
				selectButton.Size = UDim2.new(1, -20, 0, 30)
				selectButton.Position = UDim2.fromOffset(10, 31)
				selectButton.BackgroundColor3 = Color3.fromRGB(20, 24, 33)
				selectButton.BorderSizePixel = 0
				selectButton.Font = Enum.Font.Gotham
				selectButton.TextSize = 12
				selectButton.TextColor3 = Color3.fromRGB(235, 239, 248)
				selectButton.Parent = row
				round(selectButton, 6)

				local options = {}
				for _, option in ipairs(data and data.Options or {}) do
					table.insert(options, option)
				end

				local current = data and data.CurrentOption
				local first = type(current) == "table" and current[1] or options[1]

				local object = {
					CurrentOption = first and {first} or {}
				}

				local function render(callCallback)
					selectButton.Text =
						object.CurrentOption[1]
						and tostring(object.CurrentOption[1])
						or "Select"

					if callCallback and data and type(data.Callback) == "function" then
						data.Callback(object.CurrentOption)
					end
				end

				function object:Set(value)
					if type(value) == "table" then
						object.CurrentOption = value
					else
						object.CurrentOption = {value}
					end
					render(true)
				end

				function object:Refresh(newOptions)
					options = {}

					for _, option in ipairs(newOptions or {}) do
						table.insert(options, option)
					end

					if #options > 0 and not table.find(options, object.CurrentOption[1]) then
						object.CurrentOption = {options[1]}
					end

					render(false)
				end

				selectButton.MouseButton1Click:Connect(function()
					if #options == 0 then
						return
					end

					local currentValue = object.CurrentOption[1]
					local index = table.find(options, currentValue) or 0
					index = index + 1

					if index > #options then
						index = 1
					end

					object:Set({options[index]})
				end)

				if data and data.Flag then
					Fallback.Flags[data.Flag] = object
				end

				render(false)
				return object
			end

			return TabObject
		end

		-- K toggles fallback visibility.
		game:GetService("UserInputService").InputBegan:Connect(function(input, processed)
			if processed then
				return
			end

			if input.KeyCode == Enum.KeyCode.K then
				Fallback:SetVisibility(not Fallback:IsVisible())
			end
		end)

		return WindowObject
	end

	return Fallback
end

