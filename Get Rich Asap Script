		local sideLayout = Instance.new("UIListLayout")
		sideLayout.Padding = UDim.new(0, 5)
		sideLayout.SortOrder = Enum.SortOrder.LayoutOrder
		sideLayout.Parent = sidebar

		local content = Instance.new("Frame")
		content.Name = "Content"
		content.Size = UDim2.new(1, -220, 1, -76)
		content.Position = UDim2.fromOffset(210, 66)
		content.BackgroundTransparency = 1
		content.Parent = main

		local notifications = Instance.new("Frame")
		notifications.Name = "Notifications"
		notifications.Size = UDim2.fromOffset(330, 400)
		notifications.Position = UDim2.new(1, -340, 0, 10)
		notifications.BackgroundTransparency = 1
		notifications.Parent = gui

		local noteLayout = Instance.new("UIListLayout")
		noteLayout.Padding = UDim.new(0, 7)
		noteLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
		noteLayout.SortOrder = Enum.SortOrder.LayoutOrder
		noteLayout.Parent = notifications

		-- draggable fallback window
		do
			local UserInputService = game:GetService("UserInputService")
			local dragging = false
			local dragStart = nil
			local startPosition = nil

			top.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 then
					dragging = true
					dragStart = input.Position
					startPosition = main.Position
				end
			end)

			UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 then
					dragging = false
				end
			end)

			UserInputService.InputChanged:Connect(function(input)
				if not dragging then
					return
				end

				if input.UserInputType ~= Enum.UserInputType.MouseMovement then
					return
				end

				local delta = input.Position - dragStart
				main.Position = UDim2.new(
					startPosition.X.Scale,
					startPosition.X.Offset + delta.X,
					startPosition.Y.Scale,
					startPosition.Y.Offset + delta.Y
				)
			end)
		end

		local selectedTab = nil

		local WindowObject = {}

		function WindowObject:CreateTab(tabName, _icon)
			local tabButton = Instance.new("TextButton")
			tabButton.Size = UDim2.new(1, 0, 0, 35)
			tabButton.BackgroundColor3 = Color3.fromRGB(28, 34, 47)
			tabButton.BorderSizePixel = 0
			tabButton.Font = Enum.Font.GothamBold
			tabButton.Text = tostring(tabName)
			tabButton.TextSize = 12
			tabButton.TextColor3 = Color3.fromRGB(205, 213, 232)
			tabButton.Parent = sidebar
			round(tabButton, 7)

			local page = Instance.new("ScrollingFrame")
			page.Name = tostring(tabName)
			page.Size = UDim2.fromScale(1, 1)
			page.BackgroundTransparency = 1
			page.BorderSizePixel = 0
			page.ScrollBarThickness = 4
			page.AutomaticCanvasSize = Enum.AutomaticSize.Y
			page.CanvasSize = UDim2.new()
			page.Visible = false
			page.Parent = content
			padding(page, 4, 8, 4, 12)

			local layout = Instance.new("UIListLayout")
			layout.Padding = UDim.new(0, 8)
			layout.SortOrder = Enum.SortOrder.LayoutOrder
			layout.Parent = page

			local function select()
				for _, child in ipairs(content:GetChildren()) do
					if child:IsA("ScrollingFrame") then
						child.Visible = false
					end
				end

				for _, child in ipairs(sidebar:GetChildren()) do
					if child:IsA("TextButton") then
						child.BackgroundColor3 = Color3.fromRGB(28, 34, 47)
						child.TextColor3 = Color3.fromRGB(205, 213, 232)
					end
				end

				page.Visible = true
				tabButton.BackgroundColor3 = Color3.fromRGB(65, 106, 175)
				tabButton.TextColor3 = Color3.fromRGB(255, 255, 255)
				selectedTab = page
			end

			tabButton.MouseButton1Click:Connect(select)

			if not selectedTab then
				select()
			end

			local TabObject = {}

			function TabObject:CreateSection(name)
				local section = makeText(
					page,
					tostring(name),
					12,
					Enum.Font.GothamBlack,
					Color3.fromRGB(110, 165, 245)
				)
