			function TabObject:CreateButton(data)
				local button = Instance.new("TextButton")
				button.Size = UDim2.new(1, -6, 0, 39)
				button.BackgroundColor3 = Color3.fromRGB(49, 82, 138)
				button.BorderSizePixel = 0
				button.Font = Enum.Font.GothamBold
				button.Text = tostring(data and data.Name or "Button")
				button.TextSize = 12
				button.TextColor3 = Color3.fromRGB(245, 248, 255)
				button.Parent = page
				round(button, 8)

				button.MouseButton1Click:Connect(function()
					if data and type(data.Callback) == "function" then
						task.spawn(data.Callback)
