local UI_BACKEND = "Unknown"

local function createFallbackRayfield()
	-- This fallback implements the Rayfield methods used by this file.
	-- It exists so the farm UI still appears in a normal LocalScript if
	-- the official Rayfield runtime is not available.

	local Fallback = {
		Flags = {},
		_Visible = true,
		_Gui = nil,
	}

	local function round(instance, radius)
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, radius or 8)
		corner.Parent = instance
		return corner
	end

	local function stroke(instance, color, transparency)
		local s = Instance.new("UIStroke")
		s.Color = color or Color3.fromRGB(65, 75, 100)
		s.Transparency = transparency or 0.25
		s.Thickness = 1
		s.Parent = instance
		return s
	end

	local function padding(instance, left, right, top, bottom)
		local p = Instance.new("UIPadding")
		p.PaddingLeft = UDim.new(0, left or 0)
		p.PaddingRight = UDim.new(0, right or 0)
		p.PaddingTop = UDim.new(0, top or 0)
		p.PaddingBottom = UDim.new(0, bottom or 0)
		p.Parent = instance
		return p
	end

	local function makeText(parent, text, size, font, color)
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Text = text or ""
		label.TextSize = size or 13
		label.Font = font or Enum.Font.Gotham
		label.TextColor3 = color or Color3.fromRGB(230, 235, 245)
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.TextWrapped = true
		label.Parent = parent
		return label
	end

	function Fallback:SetVisibility(value)
		self._Visible = value == true
		if self._Gui then
			self._Gui.Enabled = self._Visible
		end
	end

	function Fallback:IsVisible()
		return self._Visible
	end

	function Fallback:Destroy()
		if self._Gui then
			self._Gui:Destroy()
			self._Gui = nil
		end
	end

	function Fallback:Notify(data)
		if not self._Gui then
			return
		end

		local holder = self._Gui:FindFirstChild("Notifications")
		if not holder then
			return
		end

		local card = Instance.new("Frame")
		card.Size = UDim2.fromOffset(320, 74)
		card.BackgroundColor3 = Color3.fromRGB(25, 30, 43)
		card.BorderSizePixel = 0
		card.Parent = holder
		round(card, 10)
		stroke(card, Color3.fromRGB(75, 105, 155), 0.15)

		local title = makeText(
			card,
			tostring(data and data.Title or "Notification"),
			14,
			Enum.Font.GothamBold,
			Color3.fromRGB(245, 248, 255)
		)
		title.Size = UDim2.new(1, -20, 0, 24)
		title.Position = UDim2.fromOffset(10, 8)

		local desc = makeText(
			card,
			tostring(data and data.Content or ""),
			12,
			Enum.Font.Gotham,
			Color3.fromRGB(170, 180, 205)
		)
		desc.Size = UDim2.new(1, -20, 0, 34)
		desc.Position = UDim2.fromOffset(10, 32)

		task.delay(tonumber(data and data.Duration) or 4, function()
			if card.Parent then
				card:Destroy()
			end
		end)
	end

